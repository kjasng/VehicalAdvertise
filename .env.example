# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Supabase renamed `anon` -> `publishable`. Use whichever the
# dashboard shows; the code accepts either name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias (still supported):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS for privileged writes (state transitions, GPS
# ingest, ledger, payouts). Never expose to the browser.
# Supabase renamed `service_role` -> `secret`. Use whichever the dashboard shows.
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alias (still supported):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: map tile server for maplibre-gl / react-map-gl (any MapLibre-compatible style URL)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# SePay VietQR top-up receiving account. These values are rendered into Partner Billing QR.
SEPAY_TOPUP_BANK_CODE=Vietcombank
SEPAY_TOPUP_BANK_NAME=Vietcombank
SEPAY_TOPUP_BANK_ACCOUNT=0123456789
SEPAY_TOPUP_ACCOUNT_NAME=VEHICAL ADVERTISE JSC
SEPAY_WEBHOOK_API_KEY=change-this-to-the-api-key-configured-in-sepay
SEPAY_MIN_TOPUP_VND=10000000

# Set to "true" in dev so an admin can visit /driver|/partner|/garage routes. Leave UNSET in production.
ADMIN_PANEL_BYPASS=

# SMTP — transactional email via Brevo (KYC approved/rejected, partner approved/rejected).
# Leave unset in dev to skip email sending silently.
# Setup: brevo.com → Settings → SMTP & API → Generate SMTP key
# Then: Settings → Senders & IP → Domains → add your domain + add DNS records to Cloudflare
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=noreply@yourdomain.vn

# Company/seller identity ("Bên A" / bên bán) printed on Vietnamese documents
# (hợp đồng, hóa đơn, biên bản nghiệm thu). All optional — sensible pilot defaults apply.
COMPANY_NAME=VehicalAdvertise
COMPANY_TAX_CODE=0000000000
COMPANY_ADDRESS=
COMPANY_REP_NAME=Nguyễn Văn A
COMPANY_REP_TITLE=Giám Đốc
COMPANY_PHONE=
COMPANY_EMAIL=
