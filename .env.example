# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by src/lib/supabase/admin.ts for privileged writes
# (state transitions, GPS ingest, ledger entries, payouts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: map tile server for maplibre-gl / react-map-gl (any MapLibre-compatible style URL)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
